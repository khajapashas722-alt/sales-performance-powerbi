table Dim_Customer
	lineageTag: c55cc33a-81a8-4fc7-81a7-615f0c348551

	column 'Customer ID'
		dataType: string
		isKey
		lineageTag: baa83c76-7db8-4de9-b89c-6adca8bae4a7
