	partition Dim_Customer-Partition = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:/Users/shakj/Documents/data-analytics-portfolio/power-bi/sales-performance-powerbi/data/Dim_Customer.csv"), [Delimiter=",", Columns=3, Encoding=65001, QuoteStyle=QuoteStyle.None]),
				    PromoteHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    ChangeTypes = Table.TransformColumnTypes(PromoteHeaders, {
				        {"Customer ID", type text},
				        {"Customer Name", type text},
				        {"Segment", type text}
				    }),
				    RemoveDuplicates = Table.Distinct(ChangeTypes, {"Customer ID"})
				in
